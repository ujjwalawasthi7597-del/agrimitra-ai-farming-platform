# MongoDB Connection URI (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrimitra?retryWrites=true&w=majority or mongodb://localhost:27017/agrimitra)
MONGODB_URI=

# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=

# Port on which the Express server runs (default: 3000)
PORT=3000

# API key for LLM / AI farming assistant & crop vision (supports AI_API_KEY or GEMINI_API_KEY)
AI_API_KEY=
GEMINI_API_KEY=

# Optional Weather API key (if using an external weather provider like OpenWeatherMap)
WEATHER_API_KEY=
